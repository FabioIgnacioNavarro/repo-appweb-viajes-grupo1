Authorization: Bearer {{chofer}}
Content-Type: application/json

{"disponibilidad":true}

POST {{gateway}}/viajes/estimacion
Authorization: Bearer {{pasajero}}
Content-Type: application/json

{"origen":{"latitud":-27.45,"longitud":-58.98},"destino":{"latitud":-27.46,"longitud":-58.97}}

# Copiar id_estimacion de la respuesta siguiente.
POST {{gateway}}/viajes
Authorization: Bearer {{pasajero}}
Clave-Idempotencia: manual-001
Content-Type: application/json

{"id_estimacion":"PEGAR_ID_ESTIMACION"}

GET {{gateway}}/choferes/yo/ofertas
Authorization: Bearer {{chofer}}

# Copiar id_oferta e id_viaje de la respuesta anterior.
POST {{gateway}}/choferes/yo/ofertas/PEGAR_ID_OFERTA/aceptacion
Authorization: Bearer {{chofer}}
Content-Type: application/json

{}

