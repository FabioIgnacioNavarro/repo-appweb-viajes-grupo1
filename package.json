{
  "name": "viajes-grupo1",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev:web": "vite web",
    "demo": "npm run build && node dist/terminal.js",
    "demo:web": "npm run build && node dist/servidor-web.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:carga": "node --test carga/*.test.mjs",
    "carga:flota": "node carga/simulador.mjs",
    "test:e2e": "npm run build && node --test dist/e2e.test.js",
    "test:pw": "playwright test",
    "test:pw:ui": "playwright test --ui",
    "flota": "npm run build && node dist/ms-flota/servidor.js",
    "tarifas": "npm run build && node dist/ms-tarifas/servidor.js",
    "viajes": "npm run build && node dist/ms-viajes/servidor.js",
    "auth:emulator": "npm run build && node dist/emulador-auth/servidor.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
