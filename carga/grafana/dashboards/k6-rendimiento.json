{
  "id": null,
  "uid": "viajes-k6-stress",
  "title": "Rendimiento bajo estrés k6 — Plataforma Viajes",
  "tags": ["k6", "stress", "viajes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Usuarios virtuales activos (VUs)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "k6_vus", "legendFormat": "VUs" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "blue", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Throughput actual (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(k6_http_reqs_total[15s]))", "legendFormat": "req/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tasa de checks OK",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "avg(k6_checks_rate) * 100", "legendFormat": "Checks %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errores 5xx / red (%)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "avg(k6_errores_5xx_rate) * 100", "legendFormat": "5xx %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Usuarios activos vs Throughput (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(k6_http_reqs_total[15s]))", "legendFormat": "Requests / seg" },
        { "refId": "B", "expr": "k6_vus", "legendFormat": "VUs activos" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 } } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia HTTP global (avg, p95, p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "avg(k6_http_req_duration_avg)", "legendFormat": "Promedio" },
        { "refId": "B", "expr": "max(k6_http_req_duration_p95)", "legendFormat": "p95" },
        { "refId": "C", "expr": "max(k6_http_req_duration_p99)", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia p95 por caso de uso de negocio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "max(k6_latencia_estimacion_ok_ms_p95)", "legendFormat": "Estimación tarifa (p95)" },
        { "refId": "B", "expr": "max(k6_latencia_confirmacion_ok_ms_p95)", "legendFormat": "Confirmación viaje + lock (p95)" },
        { "refId": "C", "expr": "max(k6_latencia_ubicacion_ok_ms_p95)", "legendFormat": "Ubicación chofer (p95)" },
        { "refId": "D", "expr": "max(k6_latencia_lecturas_ok_ms_p95)", "legendFormat": "Lecturas viajes/ofertas (p95)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rate limit 429 vs Errores 5xx (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "targets": [
        { "refId": "A", "expr": "avg(k6_respuestas_429_gateway_rate) * 100", "legendFormat": "Rate limit 429 (%)" },
        { "refId": "B", "expr": "avg(k6_errores_5xx_rate) * 100", "legendFormat": "Errores 5xx (%)" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12 } } }
    }
  ]
}
